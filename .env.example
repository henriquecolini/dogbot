# Postgres credentials used by docker compose.
POSTGRES_USER=dogbot
POSTGRES_PASSWORD=change-me
POSTGRES_DB=dogbot

# Connection string used by the bot. Matches the values above when running
# under docker compose.
DATABASE_URL=postgresql://dogbot:change-me@db:5432/dogbot

# From @BotFather.
TELOXIDE_TOKEN=

# SFTP server. SFTP_BIND is where the process listens inside the container;
# SFTP_HOST and SFTP_PORT are what /mount tells users to connect to, so they
# must be reachable from outside.
SFTP_BIND=0.0.0.0:2222
SFTP_HOST=localhost
SFTP_PORT=2222

RUST_LOG=info
